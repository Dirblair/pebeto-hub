# ============================================
# Pebeto Creator's Hub - Environment Variables
# ============================================
# Copy this file to .env and update with your actual values
# Never commit .env to version control!

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# ============================================
# Database Configuration
# ============================================
MONGO_URI=mongodb://127.0.0.1:27017/pebeto-creators-hub
# For MongoDB Atlas (production):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/pebeto

# ============================================
# JWT Authentication
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_EMAIL_VERIFY_EXPIRES_IN=24h
JWT_PASSWORD_RESET_EXPIRES_IN=1h
JWT_ISSUER=pebeto
JWT_AUDIENCE=pebeto-api

# ============================================
# CORS Configuration
# ============================================
# For multiple origins: https://app1.com,https://app2.com
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5000

# ============================================
# Exchange Rate API
# ============================================
# Get free API key from: https://app.exchangerate-api.com
EXCHANGE_RATE_API_KEY=your-api-key-here
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6
EXCHANGE_RATE_CACHE_TTL=3600

# ============================================
# M-Pesa Configuration (Kenya - Sandbox)
# ============================================
MPESA_ENABLED=true
MPESA_ENVIRONMENT=sandbox

# API Credentials
MPESA_CONSUMER_KEY=0o98K5I32AgUiBz2APdn4F6WrHwNgNifcYa9W6vQEh1ZKuKQn8pg1LJbMf3nlca0
MPESA_CONSUMER_SECRET=0o98K5I32AgUiBz2APdn4F6WrHwNgNifcYa9W6vQEh1ZKuKQn8pg1LJbMf3nlca0

# Paybill/Till Number
MPESA_SHORT_CODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# B2C Credentials (for withdrawals)
MPESA_INITIATOR_NAME=testapi
MPESA_


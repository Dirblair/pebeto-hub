# MPESA_PASSKEY=your-production-passkey

# ============================================
# PayPal Configuration (Global)
# ============================================
PAYPAL_ENABLED=true
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your-webhook-id
PAYPAL_MIN_AMOUNT=1
PAYPAL_MAX_AMOUNT=10000

# ============================================
# PayPal Production Configuration (Switch when live)
# ============================================
# PAYPAL_ENVIRONMENT=production
# PAYPAL_API_URL=https://api-m.paypal.com
# PAYPAL_CLIENT_ID=your-production-client-id
# PAYPAL_CLIENT_SECRET=your-production-client-secret

# ============================================
# Wire Transfer Configuration (International)
# ============================================
WIRE_ENABLED=true
WIRE_MIN_AMOUNT=100
WIRE_MAX_AMOUNT=50000
WIRE_BANK_NAME=Pebeto Partner Bank
WIRE_BANK_ADDRESS=123 Financial District, New York, NY 10005, USA
WIRE_ACCOUNT_NAME=Pebeto Global Holdings Ltd
WIRE_ACCOUNT_NUMBER=9876543210
WIRE_ROUTING_NUMBER=021000021
WIRE_SWIFT_CODE=CHASUS33
WIRE_IBAN=US12345678901234567890
WIRE_BANK_COUNTRY=USA
WIRE_CURRENCY=USD

# ============================================
# Email Configuration (For notifications)
# ============================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SECURE=false
EMAIL_FROM=noreply@pebeto.com
EMAIL_REPLY_TO=support@pebeto.com

# ============================================
# Redis Configuration (Optional - for caching)
# ============================================
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# Rate Limiting Configuration
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# ============================================
# File Upload Configuration
# ============================================
UPLOAD_MAX_SIZE_MB=100
UPLOAD_MAX_FILES=5

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ============================================
# Feature Flags
# ============================================
COMMUNITY_ENABLED=true
WITHDRAWALS_ENABLED=true
TIPS_ENABLED=true
CREATOR_REGISTRATION_ENABLED=true
BUSINESS_REGISTRATION_ENABLED=true

# ============================================
# Admin Configuration
# ============================================
# Create initial admin user (run seed script)
# ADMIN_EMAIL=admin@pebeto.com
# ADMIN_PASSWORD=your-secure-password


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Pebeto Community</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Essential: Lock the scroll and enable snapping */
        body { margin: 0; background: #000; overflow: hidden; }
        
        .feed-container {
            height: 100vh;
            width: 100vw;
            overflow-y: scroll;
            scroll-snap-type: y mandatory;
            scrollbar-width: none; /* Hide scrollbar */
        }
        
        .feed-container::-webkit-scrollbar { display: none; }

        <!-- Right Sidebar Overlay -->
<div class="right-sidebar">
    <div class="action-item">
        <div class="creator-avatar-container">
            <img src="avatar.jpg" class="creator-avatar">
            <button class="follow-btn">+</button>
        </div>
    </div>
    
    <div class="action-item" onclick="toggleLike(this)">
        <i class="ri-heart-fill"></i>
        <span class="action-count">1.2K</span>
    </div>

    <div class="action-item" onclick="openComments()">
        <i class="ri-chat-3-fill"></i>
        <span class="action-count">450</span>
    </div>

    <!-- The Fan Tip Interaction -->
    <div class="action-item" onclick="openTipModal()">
        <i class="ri-hand-coin-fill" style="color: #fbbf24;"></i>
        <span class="action-count">Tip</span>
    </div>

    <div class="action-item">
        <i class="ri-share-forward-fill"></i>
        <span class="action-count">Share</span>
    </div>
</div>

        /* The 'House' of each post */
        .post-card {
            height: 100vh;
            width: 100%;
            scroll-snap-align: start;
            position: relative;
            background: #000;
        }

        .post-media {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .right-sidebar {
    position: absolute;
    right: 12px;
    bottom: 80px; /* Sits above the nav bar */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    z-index: 50;
}

.action-item { display: flex; flex-direction: column; align-items: center; cursor: pointer; color: white; }
.action-item i { font-size: 2rem; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5)); }
.action-count { font-size: 0.75rem; font-weight: 600; margin-top: 4px; text-shadow: 0 1px 2px rgba(0,0,0,0.8); }

.creator-avatar { width: 45px; height: 45px; border-radius: 50%; border: 2px solid #fff; background: #333; }
.follow-btn { 
    position: absolute; bottom: -5px; left: 50%; transform: translateX(-50%); 
    width: 20px; height: 20px; background: #ff0050; border-radius: 50%; 
    display: flex; justify-content: center; align-items: center; font-size: 12px; font-weight: bold;
}
    </style>
</head>

    <body>

    <div class="feed-container" id="feed">
        <article class="post-card">
            <video class="post-media" src="video1.mp4" loop muted playsinline></video>
        </article>
        
        <article class="post-card">
            <video class="post-media" src="video2.mp4" loop muted playsinline></video>

            <!-- This is your floating sidebar -->
    <div class="right-sidebar">
        <div class="action-item">
            <div class="creator-avatar-container" style="position: relative;">
                <img src="avatar.jpg" class="creator-avatar">
                <button class="follow-btn">+</button>
            </div>
        </div>
        
        <div class="action-item">
            <i class="ri-heart-fill"></i>
            <span class="action-count">1.2K</span>
        </div>

        <div class="action-item">
            <i class="ri-chat-3-fill"></i>
            <span class="action-count">450</span>
        </div>

        <div class="action-item">
            <i class="ri-hand-coin-fill" style="color: #fbbf24;"></i>
            <span class="action-count">Tip</span>
        </div>

        <div class="action-item">
            <i class="ri-share-forward-fill"></i>
            <span class="action-count">Share</span>
        </div>
    </div>
</article>
    </div>

    <script>
        // Intersection Observer: Only plays the video currently in view
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                const video = entry.target.querySelector('video');
                if (entry.isIntersecting) {
                    video.play();
                } else {
                    video.pause();
                    video.currentTime = 0; // Reset video when off-screen
                }
            });
        }, { threshold: 0.7 });

        document.querySelectorAll('.post-card').forEach(card => observer.observe(card));
   <script>
    function goToHub() {
        // You would perform your Auth check here
        const userRole = localStorage.getItem('userRole'); // Example check
        if (userRole === 'business') {
            window.location.href = '/business.html';
        } else if (userRole === 'creator') {
            window.location.href = '/creator.html';
        } else {
            window.location.href = '/signup.html';
        }
    }
</script>
    </script>
<nav class="bottom-navbar">
    <div class="nav-item active" onclick="window.location.href='/community.html'">
        <i class="ri-home-fill"></i>
        <span class="nav-label">Home</span>
    </div>
    <div class="nav-item" onclick="/* Open Discover */">
        <i class="ri-compass-line"></i>
        <span class="nav-label">Discover</span>
    </div>
    <div class="create-btn-container" onclick="/* Open Create Modal */">
        <div class="create-btn-inner">+</div>
    </div>
    <div class="nav-item" onclick="window.location.href='/bids.html'">
        <i class="ri-briefcase-line"></i>
        <span class="nav-label">Bids</span>
    </div>
    <div class="nav-item" onclick="goToHub()">
        <i class="ri-user-line"></i>
        <span class="nav-label">Profile</span>
    </div>
</nav>

<style>
    .bottom-navbar {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 60px;
        background-color: rgba(0, 0, 0, 0.9);
        border-top: 1px solid #222;
        display: flex;
        justify-content: space-around;
        align-items: center;
        z-index: 100;
    }
    .nav-item { display: flex; flex-direction: column; align-items: center; cursor: pointer; color: #8a8b91; }
    .nav-item.active { color: #fff; }
    .nav-item i { font-size: 1.4rem; }
    .nav-label { font-size: 0.65rem; margin-top: 2px; }
    
    .create-btn-container {
        width: 45px; height: 30px;
        background: linear-gradient(to right, #00f2fe, #4facfe);
        border-radius: 8px; display: flex; justify-content: center; align-items: center;
    }
    .create-btn-inner {
        width: 37px; height: 100%; background-color: #fff;
        border-radius: 8px; display: flex; justify-content: center; align-items: center;
        color: #000; font-weight: bold; font-size: 1.2rem; cursor: pointer;
    }
</style>
    </body>
</html>
